# Login con Microsoft (fase 11). Copia este archivo como .env.local y completa el Client ID
# de la app registrada en Microsoft Entra ID (ver docs/AZURE.md). Sin Client ID la app usa
# una sesión de prueba de administrador.
VITE_MSAL_CLIENT_ID=
# "common": cuentas de empresa y personales. Para solo la empresa: https://login.microsoftonline.com/<TENANT_ID>
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/common
